# The packager names the addon folder after the repository unless told
# otherwise. This repo is Sszorak-Map-Helper but the folder inside the zip has
# to match the .toc filename exactly, or the game will not load it.
package-as: Sszorak-Map-Helper

# Ship the hand-written notes as the release changelog instead of a
# generated list of commit subjects.
manual-changelog: CHANGELOG.md

ignore:
  - .github
  - README.md
  - .gitignore
  - docs
